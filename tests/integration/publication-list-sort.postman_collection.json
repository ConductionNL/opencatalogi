				"url": { "raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication", "host": ["{{baseUrl}}"], "path": ["apps", "openregister", "api", "objects", "publication", "publication"] }
			}
		},
		{
			"name": "Setup: update Bravo so it is the most recently updated",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"setTimeout(() => {}, 1100);"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('updated (200)', () => pm.response.to.have.status(200));"
						]
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"body": { "mode": "raw", "raw": "{\"title\": \"{{runId}} Bravo\", \"status\": \"published\", \"summary\": \"updated\"}" },
				"url": { "raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication/{{idBravo}}", "host": ["{{baseUrl}}"], "path": ["apps", "openregister", "api", "objects", "publication", "publication", "{{idBravo}}"] }
			}
		},
		{
			"name": "Default page sort: created desc with uuid tie-break",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200', () => pm.response.to.have.status(200));",
							"const prefix = pm.collectionVariables.get('runId') + ' ';",
							"const titles = pm.response.json().results.map((r) => r.title.replace(prefix, ''));",
							"pm.test('newest first', () => pm.expect(titles).to.eql(['Charlie', 'Alpha', 'Bravo']));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication?_search={{runId}}&_limit=10&_order=%7B%22%40self.created%22%3A%22desc%22%2C%22_uuid%22%3A%22asc%22%7D",
					"host": ["{{baseUrl}}"],
					"path": ["apps", "openregister", "api", "objects", "publication", "publication"],
					"query": [
						{ "key": "_search", "value": "{{runId}}" },
						{ "key": "_limit", "value": "10" },
						{ "key": "_order", "value": "%7B%22%40self.created%22%3A%22desc%22%2C%22_uuid%22%3A%22asc%22%7D", "description": "{\"@self.created\":\"desc\",\"_uuid\":\"asc\"}" }
					]
				}
			}
		},
