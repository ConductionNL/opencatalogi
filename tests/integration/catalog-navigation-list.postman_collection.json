            "exec": [
              "pm.test('deleted', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/{{catalogRegister}}/{{catalogSchema}}/{{catalogAId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "index.php",
            "apps",
            "openregister",
            "api",
            "objects",
            "{{catalogRegister}}",
            "{{catalogSchema}}",
            "{{catalogAId}}"
          ]
        }
      }
    },
    {
      "name": "NAV-CAT-008 The list no longer shows the deleted catalog",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const results = pm.response.json().results || [];",
              "pm.test('catalog A is gone', () => pm.expect(results.some((c) => (c.id || (c['@self'] || {}).id) === pm.collectionVariables.get('catalogAId'))).to.be.false);",
              "pm.test('no catalog with its slug remains', () => pm.expect(results.some((c) => c.slug === pm.collectionVariables.get('catalogASlug'))).to.be.false);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/{{catalogRegister}}/{{catalogSchema}}?slug={{catalogASlug}}&_source=database",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "index.php",
            "apps",
            "openregister",
            "api",
            "objects",
            "{{catalogRegister}}",
            "{{catalogSchema}}"
          ],
          "query": [
            {
              "key": "slug",
              "value": "{{catalogASlug}}"
            },
            {
              "key": "_source",
              "value": "database"
            }
          ]
        }
      }
    },
    {
      "name": "NAV-CAT-009 Clean up catalog B",
      "event": [
