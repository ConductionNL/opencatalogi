{
	"info": {
		"_postman_id": "opencatalogi-publication-list-search",
		"name": "OpenCatalogi - Publication list search",
		"description": "API contract tests for the Publications index page search (ConductionNL/opencatalogi#1582). The page sends the search term to OpenRegister's objects endpoint as `_search`; these requests assert that the term matches on title, summary and description over the whole result set server-side, case-insensitively, that `total` is the filtered count, that paging keeps the filter, that a term without hits returns an empty list, and that leaving `_search` out restores the full list.\n\nThe collection creates three publications under a unique run id, each carrying a marker in a different field, and deletes them at the end.\n\nVariables:\n- baseUrl (default http://localhost:8080)\n- userAuth: Basic auth for an admin",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
		{ "key": "userAuth", "value": "Basic YWRtaW46YWRtaW4=", "type": "string" },
		{ "key": "runId", "value": "", "type": "string" },
		{ "key": "idAlpha", "value": "", "type": "string" },
		{ "key": "idBravo", "value": "", "type": "string" },
		{ "key": "idCharlie", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "Setup: create Alpha (marker in the title)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.collectionVariables.set('runId', 'zsrch' + Date.now());"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('created (200/201)', () => pm.expect([200, 201]).to.include(pm.response.code));",
							"pm.collectionVariables.set('idAlpha', pm.response.json().id || '');"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"body": { "mode": "raw", "raw": "{\"title\": \"{{runId}} Alpha {{runId}}title\", \"summary\": \"A plain summary\", \"description\": \"A plain description that also says {{runId}}both\"}" },
				"url": { "raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication", "host": ["{{baseUrl}}"], "path": ["apps", "openregister", "api", "objects", "publication", "publication"] }
			}
		},
		{
			"name": "Setup: create Bravo (marker in the summary)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('created (200/201)', () => pm.expect([200, 201]).to.include(pm.response.code));",
							"pm.collectionVariables.set('idBravo', pm.response.json().id || '');"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"body": { "mode": "raw", "raw": "{\"title\": \"{{runId}} Bravo {{runId}}both\", \"summary\": \"A summary with {{runId}}summary in it\", \"description\": \"A plain description\"}" },
				"url": { "raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication", "host": ["{{baseUrl}}"], "path": ["apps", "openregister", "api", "objects", "publication", "publication"] }
			}
		},
		{
			"name": "Setup: create Charlie (marker in the description)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('created (200/201)', () => pm.expect([200, 201]).to.include(pm.response.code));",
							"pm.collectionVariables.set('idCharlie', pm.response.json().id || '');"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"body": { "mode": "raw", "raw": "{\"title\": \"{{runId}} Charlie\", \"summary\": \"A plain summary\", \"description\": \"A description with {{runId}}desc in it\"}" },
				"url": { "raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication", "host": ["{{baseUrl}}"], "path": ["apps", "openregister", "api", "objects", "publication", "publication"] }
			}
		},
		{
			"name": "Search matches on the title",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200', () => pm.response.to.have.status(200));",
							"const body = pm.response.json();",
							"pm.test('only Alpha', () => pm.expect(body.results.map((r) => r.id)).to.eql([pm.collectionVariables.get('idAlpha')]));",
							"pm.test('total is the filtered count', () => pm.expect(body.total).to.eql(1));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication?_search={{runId}}title&_limit=10",
					"host": ["{{baseUrl}}"],
					"path": ["apps", "openregister", "api", "objects", "publication", "publication"],
					"query": [
						{ "key": "_search", "value": "{{runId}}title" },
						{ "key": "_limit", "value": "10" }
					]
				}
			}
		},
