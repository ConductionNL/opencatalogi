					]
				}
			}
		},
		{
			"name": "Search ignores case",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.variables.set('upperTerm', (pm.collectionVariables.get('runId') + 'title').toUpperCase());"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200', () => pm.response.to.have.status(200));",
							"pm.test('upper case still finds Alpha', () => pm.expect(pm.response.json().results.map((r) => r.id)).to.eql([pm.collectionVariables.get('idAlpha')]));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication?_search={{upperTerm}}&_limit=10",
					"host": ["{{baseUrl}}"],
					"path": ["apps", "openregister", "api", "objects", "publication", "publication"],
					"query": [
						{ "key": "_search", "value": "{{upperTerm}}" },
						{ "key": "_limit", "value": "10" }
					]
				}
			}
		},
		{
			"name": "A term in different fields of two publications counts both",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200', () => pm.response.to.have.status(200));",
							"const body = pm.response.json();",
							"const expected = [pm.collectionVariables.get('idAlpha'), pm.collectionVariables.get('idBravo')].sort();",
							"pm.test('Alpha (description) and Bravo (title)', () => pm.expect(body.results.map((r) => r.id).sort()).to.eql(expected));",
							"pm.test('total is the filtered count', () => pm.expect(body.total).to.eql(2));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication?_search={{runId}}both&_limit=10",
					"host": ["{{baseUrl}}"],
					"path": ["apps", "openregister", "api", "objects", "publication", "publication"],
					"query": [
						{ "key": "_search", "value": "{{runId}}both" },
						{ "key": "_limit", "value": "10" }
					]
				}
			}
		},
		{
			"name": "Paging keeps the search: page 1",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200', () => pm.response.to.have.status(200));",
							"const body = pm.response.json();",
							"pm.test('total counts the whole run, not the page', () => pm.expect(body.total).to.eql(3));",
							"pm.test('page 1 of 2', () => pm.expect([body.page, body.pages]).to.eql([1, 2]));",
							"pm.test('Alpha and Bravo on page 1', () => pm.expect(body.results.map((r) => r.id)).to.eql([pm.collectionVariables.get('idAlpha'), pm.collectionVariables.get('idBravo')]));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication?_search={{runId}}&_limit=2&_page=1&_order=%7B%22title%22%3A%22asc%22%7D",
					"host": ["{{baseUrl}}"],
					"path": ["apps", "openregister", "api", "objects", "publication", "publication"],
					"query": [
						{ "key": "_search", "value": "{{runId}}" },
						{ "key": "_limit", "value": "2" },
						{ "key": "_page", "value": "1" },
						{ "key": "_order", "value": "%7B%22title%22%3A%22asc%22%7D", "description": "{\"title\":\"asc\"}" }
					]
				}
			}
		},
