* text=auto eol=lf

*.conf text eol=lf
*.html text eol=lf
*.ini text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.php text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
bin/console text eol=lf

*.ico binary
*.png binary

.github export-ignore
.travis.yml export-ignore
LICENSE export-ignore
README.md export-ignore
update-deps.sh export-ignore

# Generated files. GitHub collapses them in diffs and leaves them out of the
# language statistics.
l10n/*.js linguist-generated=true
openapi.json linguist-generated=true
lib/Settings/example-sets/**/*.pdf linguist-generated=true

# Reference value lists copied from the official government sources.
lib/Settings/tooi_waardelijsten.json linguist-vendored=true
lib/Settings/dcat_waardelijsten.json linguist-vendored=true
