                                        "output": "page"
                                    }
                                },
                                {
                                    "id": "hits",
                                    "type": "openregister.explode",
                                    "config": {
                                        "path": "page.results",
                                        "as": "hit",
                                        "keepRecord": false
                                    }
                                },
                                {
                                    "id": "fetch",
                                    "type": "openconnector.source-call",
                                    "onError": "continue",
                                    "config": {
                                        "source": "github-raw",
                                        "endpoint": "/{{ hit.repository.full_name }}/HEAD/{{ hit.path }}",
                                        "method": "GET",
                                        "decode": "yaml",
                                        "output": "publiccode"
                                    }
                                },
                                {
                                    "id": "decoded",
                                    "type": "openregister.filter",
                                    "config": {
                                        "condition": {
                                            "and": [
                                                {
                                                    "!!": [
                                                        {
                                                            "var": "json.publiccode.body.name"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "!!": [
                                                        {
                                                            "var": "json.publiccode.body.url"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    }
                                },
                                {
                                    "id": "map",
                                    "type": "openregister.map",
                                    "config": {
                                        "mapping": "publiccode-github-hit"
                                    }
                                },
                                {
                                    "id": "write",
                                    "type": "openregister.object-write",
                                    "config": {
                                        "operation": "upsert",
                                        "register": "publication",
                                        "schema": "publiccode",
                                        "payloadFrom": "component",
                                        "match": {
                                            "@self.slug": "{{ component.slug }}"
                                        },
                                        "maxWrites": 25000
                                    }
                                },
                                {
                                    "id": "end",
                                    "type": "openregister.end",
                                    "config": {}
                                }
                            ],
