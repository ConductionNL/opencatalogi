      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/{{catalogRegister}}/{{catalogSchema}}/{{catalogBId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "index.php",
            "apps",
            "openregister",
            "api",
            "objects",
            "{{catalogRegister}}",
            "{{catalogSchema}}",
            "{{catalogBId}}"
          ]
        }
      }
    }
  ],
