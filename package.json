{
  "name": "opencatalogi",
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "test": "jest --silent",
    "test-coverage": "jest --silent --coverage",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "stylelint": "stylelint \"{src,css}/**/*.{vue,scss,css}\"",
    "stylelint:fix": "stylelint \"{src,css}/**/*.{vue,scss,css}\" --fix",
    "check:l10n": "node scripts/check-l10n.js",
    "check:manifest": "node tests/validate-manifest.js",
    "clean:l10n": "node scripts/clean-l10n.js --apply",
    "find:unwrapped": "node scripts/find-unwrapped.js",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project docs-capture",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --check \"**/*.{js,ts,vue,css,scss}\"",
    "format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss}\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@conduction/nextcloud-vue": "^2.3.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "6.6.0",
    "@fortawesome/free-regular-svg-icons": "6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@kangc/v-md-editor": "^2.3.18",
    "@mdi/js": "^7.4.47",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.5.0",
    "@toast-ui/editor": "^3.2.2",
    "@uiw/codemirror-theme-vscode": "^4.23.6",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.7.4",
    "css-loader": "~7.1.1",
    "dexie": "^4.0.8",
    "dompurify": "^3.4.5",
    "gridstack": "^12.6.0",
    "highlight.js": "^11.11.1",
    "lodash": "^4.17.21",
    "marked": "^12.0.0",
    "node-polyfill-webpack-plugin": "4.0.0",
    "path-browserify": "^1.0.1",
    "pinia": "^2.2.2",
    "style-loader": "~4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "validator": "^13.12.0",
    "vue": "^3.5.13",
    "vue-codemirror6": "^1.5.0",
    "vue-draggable-plus": "^0.6.0",
    "vue-loader": "^17.4.2",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.5.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.28.5",
    "@codemirror/lang-html": "^6.4.11",
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/prettier-config": "^1.2.0",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@pinia/testing": "^0.1.5",
    "@playwright/test": "^1.49.0",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.5.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "axe-core": "^4.10.0",
    "babel-loader": "^10.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-webpack-plugin": "^6.0.0",
    "espree": "^11.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "postcss-html": "^1.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.98.0",
    "sass-loader": "^17.0.0",
    "stylelint": "^15.6.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-config-recommended-vue": "^1.1.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.3.0"
  },
  "overrides": {
    "@nextcloud/axios": "~2.5.2",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "dompurify": "$dompurify",
    "d3-color": "^3.1.0",
    "mermaid": ">=11.4.1",
    "json5": "^2.2.3",
    "@braintree/sanitize-url": "^7.0.0",
    "katex": "^0.16.0",
    "@tootallnate/once": ">=3.0.1",
    "postcss": ">=8.4.47",
    "fast-xml-parser": ">=5.7.0",
    "markdown-it": ">=12.3.2",
    "uuid": ">=14.0.0"
  },
  "prettier": "@nextcloud/prettier-config"
}
