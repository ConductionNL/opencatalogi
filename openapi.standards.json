  "components": {
    "headers": {
      "AccessControlAllowOrigin": {
        "description": "CORS allowed origin (`*` unless an allowlist is configured).",
        "schema": {
          "type": "string"
        }
      },
      "APIVersion": {
        "description": "The version of the API that answered, which is the installed app version.",
        "schema": {
          "type": "string",
          "example": "1.0.0"
        }
      },
      "AccessControlAllowHeaders": {
        "description": "CORS allowed request headers.",
        "schema": {
          "type": "string"
        }
      },
      "AccessControlAllowMethods": {
        "description": "CORS allowed HTTP methods.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ObjectRecord": {
        "type": "object",
        "description": "A single register-defined object (publication, document, catalog, page, menu, theme, glossary term, listing, …). Properties beyond `@self` are defined by the instance's configured schema and are intentionally NOT frozen in this document (design decision D3) — additionalProperties: true.",
        "properties": {
          "@self": {
            "$ref": "#/components/schemas/SelfMeta"
          }
        },
        "additionalProperties": true
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details. The members the endpoint returned before, `error` and `message`, are kept.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI that identifies the problem type.",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "The HTTP reason phrase of the status."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "What went wrong, for this occurrence."
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "DcatDocument": {
        "description": "DCAT-AP-NL RDF document. Serialization is content-negotiated via `?format=` (authoritative) or the `Accept` header; body shape depends on the negotiated media type (JSON-LD object, or a Turtle/RDF-XML string)."
      },
      "WithheldEntry": {
        "type": "object",
        "description": "A document withheld from publication: its position in the publication and the grounds, never its content (REQ-PDP-004, REQ-WDW-003).",
        "required": [
          "position",
          "grounds",
          "groundDetails"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "description": "Position of the document in the publication, from 1."
          },
          "grounds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The refusal ground codes."
          },
          "groundDetails": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "article",
                "label"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "article": {
                  "type": "string",
                  "description": "Empty when the code could not be resolved; never guessed."
                },
                "label": {
                  "type": "string",
                  "description": "Empty when the code could not be resolved; never guessed."
                }
              }
            }
          },
          "title": {
            "type": "string",
            "description": "Only on an entry from a publication batch whose assessment has titlePublic true."
          }
        }
      },
      "SchemaOrgDataCatalog": {
        "type": "object",
        "description": "A schema.org `DataCatalog` JSON-LD node (single document, no result envelope).",
        "properties": {
          "@context": {
            "type": "string"
          },
          "@type": {
            "type": "string",
            "enum": [
              "DataCatalog"
            ]
          }
        },
        "additionalProperties": true
      },
      "PaginatedEnvelope": {
        "type": "object",
        "description": "Standard OpenRegister `searchObjectsPaginated` list envelope.",
        "required": [
          "results",
          "total"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObjectRecord"
            }
          },
          "total": {
            "type": "integer",
            "description": "Total matching objects across all pages."
          },
          "page": {
            "type": "integer",
            "description": "Current 1-based page number."
          },
          "pages": {
            "type": "integer",
            "description": "Total number of pages."
          },
          "facets": {
            "type": "object",
            "description": "Facet counts, present when `_facets` was requested.",
            "additionalProperties": true,
            "nullable": true
          }
        },
        "additionalProperties": true
      },
      "SelfMeta": {
        "type": "object",
        "description": "OpenRegister object metadata. The exact property set is register/schema dependent and MUST NOT be frozen here — additionalProperties covers it.",
        "properties": {
          "id": {
            "type": "string"
          },
          "uuid": {
            "type": "string"
          },
          "register": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "schema": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "published": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": true
      },
      "PublicPublication": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ObjectRecord"
          },
          {
            "type": "object",
            "properties": {
              "withheld": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/WithheldEntry"
                },
                "description": "Present only when the catalogue (on the federation route: every catalogue holding the publication) has showWithheld true and the list could be read and holds at least one entry; absent otherwise, including when nothing was recorded for the publication."
              }
            }
          }
        ]
      },
      "FederationEnvelope": {
        "description": "Aggregated local + federated publication list with pagination links.",
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer"
              },
              "offset": {
                "type": "integer"
              },
              "next": {
                "type": "string",
                "format": "uri",
                "nullable": true
              },
              "prev": {
                "type": "string",
                "format": "uri",
                "nullable": true
              },
              "facetable": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        ]
      }
    },
    "parameters": {
      "SitemapPageParam": {
        "name": "page",
        "in": "query",
        "description": "1-based page number for the sitemap page document.",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "LimitParam": {
        "name": "_limit",
        "in": "query",
        "description": "Page size.",
        "schema": {
          "type": "integer",
          "default": 20,
          "minimum": 0
        }
      },
      "CategoryCodePath": {
        "name": "categoryCode",
        "in": "path",
        "required": true,
        "description": "DIWOO information-category code (e.g. `infocat014`).",
        "schema": {
          "type": "string"
        }
      },
      "PageParam": {
        "name": "_page",
        "in": "query",
        "description": "1-based page number.",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "FormatParam": {
        "name": "format",
        "in": "query",
        "description": "Explicit DCAT serialization format; overrides `Accept` header negotiation.",
        "schema": {
          "type": "string",
          "enum": [
            "jsonld",
            "turtle",
            "rdfxml"
          ]
        }
      },
      "CatalogSlugPath": {
        "name": "catalogSlug",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      },
      "DcatPageParam": {
        "name": "page",
        "in": "query",
        "description": "1-based page number for harvester-grade pagination of the per-catalog DCAT feed.",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "CourseIdPath": {
        "name": "courseId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "SearchParam": {
        "name": "_search",
        "in": "query",
        "description": "Free-text search term applied across the scoped schema(s).",
        "schema": {
          "type": "string"
        }
      },
      "FacetsParam": {
        "name": "_facets",
        "in": "query",
        "description": "Facet request, e.g. `_facets[@self][register]=true`. Object shape mirrors OpenRegister's facet-query dialect; additionalProperties covers the nested keys.",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "CorsPreflight": {
        "description": "Preflight answered; no body.",
        "headers": {
          "Access-Control-Allow-Origin": {
            "$ref": "#/components/headers/AccessControlAllowOrigin"
          },
          "Access-Control-Allow-Methods": {
            "$ref": "#/components/headers/AccessControlAllowMethods"
          },
          "Access-Control-Allow-Headers": {
            "$ref": "#/components/headers/AccessControlAllowHeaders"
          },
          "API-Version": {
            "$ref": "#/components/headers/APIVersion"
          }
        }
      },
      "NotFound": {
        "description": "The requested resource does not exist.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected server error.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "The search/data backend (OpenRegister) is not installed or not configured.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
