{
    "$comment": "openspec/changes/publiccode-github-harvest. The harvest flow on the publiccode schema, the OpenRegister mapping it writes through, and the Componenten catalogue that makes harvested components searchable. The shard synchronizations the flow names are NOT seeded here: OpenRegister skips an object whose register is missing, so an install without integriq would never get them. PubliccodeHarvestService::setUp() writes them from lib/Settings/publiccode-github-shards.json when an administrator asks.",
    "components": {
        "schemas": {
            "publiccode": {
                "configuration": {
                    "x-openregister-flows": [
                        {
                            "name": "GitHub publiccode harvest",
                            "app": "opencatalogi",
                            "description": "Reads every publiccode.yml on GitHub into the publiccode schema (openspec/changes/publiccode-github-harvest). Each shard searches one file size range, because a GitHub code search stops at 1,000 results. The shards hang directly off the triggers and never off each other: chained, each shard reruns its search once per page the previous shard found (12 runs became 3,472 on 2026-08-13). Ships disabled; set it up and switch it on in the OpenCatalogi admin settings, section GitHub harvest. Needs integriq with its github-api and github-raw sources.",
                            "trigger": "schedule",
                            "enabled": false,
                            "executionMode": "async",
                            "limits": {
                                "maxRuntimeMinutes": 240
                            },
                            "nodes": [
                                {
                                    "id": "nightly",
                                    "type": "openregister.trigger-schedule",
                                    "config": {
                                        "cron": "15 3 * * *",
                                        "runAs": "admin"
                                    }
                                },
                                {
                                    "id": "on-demand",
                                    "type": "openregister.trigger-manual",
                                    "config": {}
                                },
                                {
                                    "id": "shard-01",
                                    "type": "openconnector.source-paginate",
                                    "config": {
                                        "synchronization": "opencatalogi-publiccode-github-01",
                                        "output": "page"
                                    }
                                },
                                {
                                    "id": "shard-02",
                                    "type": "openconnector.source-paginate",
                                    "config": {
                                        "synchronization": "opencatalogi-publiccode-github-02",
                                        "output": "page"
                                    }
                                },
                                {
                                    "id": "shard-03",
                                    "type": "openconnector.source-paginate",
                                    "config": {
                                        "synchronization": "opencatalogi-publiccode-github-03",
                                        "output": "page"
                                    }
                                },
                                {
                                    "id": "shard-04",
                                    "type": "openconnector.source-paginate",
                                    "config": {
                                        "synchronization": "opencatalogi-publiccode-github-04",
                                        "output": "page"
                                    }
                                },
                                {
                                    "id": "shard-05",
                                    "type": "openconnector.source-paginate",
                                    "config": {
                                        "synchronization": "opencatalogi-publiccode-github-05",
                                        "output": "page"
                                    }
                                },
                                {
                                    "id": "shard-06",
                                    "type": "openconnector.source-paginate",
                                    "config": {
                                        "synchronization": "opencatalogi-publiccode-github-06",
                                        "output": "page"
                                    }
                                },
                                {
                                    "id": "shard-07",
                                    "type": "openconnector.source-paginate",
                                    "config": {
                                        "synchronization": "opencatalogi-publiccode-github-07",
                                        "output": "page"
                                    }
                                },
                                {
                                    "id": "shard-08",
                                    "type": "openconnector.source-paginate",
                                    "config": {
                                        "synchronization": "opencatalogi-publiccode-github-08",
                                        "output": "page"
