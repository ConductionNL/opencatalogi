{
	"info": {
		"_postman_id": "opencatalogi-publication-list-sort",
		"name": "OpenCatalogi - Publication list sort",
		"description": "API contract tests for the Publications index page sort (ConductionNL/opencatalogi#1351). The page asks OpenRegister's objects endpoint for `_order` as a JSON object; these requests assert that every column the page sorts on (title, status, @self.created, @self.updated) orders the whole result set server-side, that paging keeps the order, and that the bracket form `_order[field]=DIR` matches the JSON form.\n\nThe collection creates three publications under a unique run id, isolates them with `_search`, and deletes them at the end.\n\nVariables:\n- baseUrl (default http://localhost:8080)\n- userAuth: Basic auth for an admin",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
		{ "key": "userAuth", "value": "Basic YWRtaW46YWRtaW4=", "type": "string" },
		{ "key": "runId", "value": "", "type": "string" },
		{ "key": "idAlpha", "value": "", "type": "string" },
		{ "key": "idBravo", "value": "", "type": "string" },
		{ "key": "idCharlie", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "Setup: create Bravo (published, oldest)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.collectionVariables.set('runId', 'zsort' + Date.now());"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('created (200/201)', () => pm.expect([200, 201]).to.include(pm.response.code));",
							"pm.collectionVariables.set('idBravo', pm.response.json().id || '');"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"body": { "mode": "raw", "raw": "{\"title\": \"{{runId}} Bravo\", \"status\": \"published\"}" },
				"url": { "raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication", "host": ["{{baseUrl}}"], "path": ["apps", "openregister", "api", "objects", "publication", "publication"] }
			}
		},
		{
