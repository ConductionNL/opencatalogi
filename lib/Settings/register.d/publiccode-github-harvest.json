        "mappings": {
            "publiccode-github-hit": {
                "slug": "publiccode-github-hit",
                "name": "GitHub publiccode.yml to publiccode",
                "description": "Turns one GitHub code search hit with its decoded publiccode.yml (at publiccode.body) into a publiccode object under `component`. Optional fields use |default('') and the cast unsetIfValue==, because a bare dot path whose key is missing renders the path itself as a literal string. Lists pass through json_encode and jsonToArray.",
                "version": "1.0.0",
                "passThrough": false,
                "mapping": {
                    "component.slug": "{{ (hit.repository.full_name ~ (hit.path != 'publiccode.yml' ? '-' ~ hit.path|replace({'/publiccode.yml': ''}) : ''))|lower|replace({'/': '-', '.': '-', '_': '-', ' ': '-'}) }}",
                    "component.name": "{{ publiccode.body.name|default('') }}",
                    "component.applicationSuite": "{{ publiccode.body.applicationSuite|default('') }}",
                    "component.url": "{{ publiccode.body.url|default('') }}",
                    "component.landingURL": "{{ publiccode.body.landingURL|default('') }}",
                    "component.softwareVersion": "{{ publiccode.body.softwareVersion|default('') }}",
                    "component.releaseDate": "{{ publiccode.body.releaseDate is defined and publiccode.body.releaseDate ? publiccode.body.releaseDate|date('Y-m-d', false) : '' }}",
                    "component.logo": "{{ publiccode.body.logo|default('') }}",
                    "component.platforms": "{{ publiccode.body.platforms|default([])|json_encode }}",
                    "component.categories": "{{ publiccode.body.categories|default([])|json_encode }}",
                    "component.developmentStatus": "{{ publiccode.body.developmentStatus|default('') }}",
                    "component.softwareType": "{{ publiccode.body.softwareType|default('') }}",
                    "component.description": "{{ publiccode.body.description|default({})|json_encode }}",
                    "component.maintenanceType": "{{ publiccode.body.maintenance.type|default('') }}",
                    "component.maintainers": "{{ (publiccode.body.maintenance.contractors|default([]))|merge(publiccode.body.maintenance.contacts|default([]))|json_encode }}",
                    "component.legalLicense": "{{ publiccode.body.legal.license|default('') }}",
                    "component.legalRepoOwner": "{{ publiccode.body.legal.repoOwner|default('') }}",
                    "component.localisationAvailableLanguages": "{{ publiccode.body.localisation.availableLanguages|default([])|json_encode }}",
                    "component.itConformsTo": "{% set conforms = [] %}{% for standard, conforms_to in publiccode.body.it.conforme|default({}) %}{% if conforms_to %}{% set conforms = conforms|merge([standard]) %}{% endif %}{% endfor %}{{ conforms|json_encode }}",
                    "component.publiccodeYmlVersion": "{{ publiccode.body.publiccodeYmlVersion|default('') }}",
                    "component.harvestedFrom": "github.com",
                    "component.harvestedAt": "{{ 'now'|date('c', 'UTC') }}",
                    "component.rawPubliccode": "publiccode.body"
                },
                "cast": {
                    "component.name": [
                        "unsetIfValue=="
                    ],
                    "component.applicationSuite": [
                        "unsetIfValue=="
