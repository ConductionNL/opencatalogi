{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenCatalogi standard protocol endpoints",
    "version": "2.1.16-unstable.20261010175130",
    "description": "The public endpoints of OpenCatalogi that implement an external standard (DCAT-AP, OOAPI, schema.org, DiWoo sitemaps, robots.txt, Atom feeds, federation between instances; listed in lib/Middleware/Support/StandardProtocolPaths.php). Their URLs, request and error formats are the ones their standard defines, so they keep their unversioned paths and are not part of the versioned API that openapi.json describes.",
    "contact": {
      "name": "Conduction",
      "url": "https://www.conduction.nl/",
      "email": "info@conduction.nl"
    },
    "license": {
      "name": "EUPL-1.2",
      "url": "https://eupl.eu/1.2/en/"
    }
  },
  "servers": [
    {
      "url": "https://{host}/index.php/apps/opencatalogi/api",
      "description": "The unversioned base of the paths that implement an external standard (DCAT-AP, OOAPI, schema.org, sitemaps, feeds, federation), which keep their own URLs.",
      "variables": {
        "host": {
          "default": "your-nextcloud.example.org",
          "description": "Hostname of the Nextcloud instance running OpenCatalogi."
        }
      }
    }
  ],
  "paths": {
    "/catalogs/{catalogSlug}/dcat": {
      "get": {
        "operationId": "dcat-catalog",
        "summary": "Per-catalog DCAT-AP-NL document",
        "description": "DCAT-AP-NL document for one catalog. Only publicly-visible objects appear (DCAT-003). Supports conditional GET via ETag (304) and harvester-grade pagination via `page` (DCAT-008).",
        "tags": [
          "DCAT"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CatalogSlugPath"
          },
          {
            "$ref": "#/components/parameters/FormatParam"
          },
          {
            "$ref": "#/components/parameters/DcatPageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/ld+json": {
                "schema": {
                  "$ref": "#/components/schemas/DcatDocument"
                }
              },
              "text/turtle": {
                "schema": {
                  "$ref": "#/components/schemas/DcatDocument"
                }
              },
              "application/rdf+xml": {
                "schema": {
                  "$ref": "#/components/schemas/DcatDocument"
                }
              }
            },
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            }
          },
          "304": {
            "description": "Not modified (ETag matched `If-None-Match`).",
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "406": {
            "description": "Unsupported format requested."
          }
        }
      },
      "options": {
        "operationId": "dcat-catalog-preflight",
        "summary": "CORS preflight",
        "description": "CORS preflight for the per-catalog DCAT document.",
        "tags": [
          "DCAT"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CatalogSlugPath"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/CorsPreflight"
          }
        }
      }
    },
    "/catalogs/{catalogSlug}/ooapi/v5/courses": {
