{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "retention-review-queue (RET-007; boards OcBewaartermijnen and OcTermijnVerlengen). The publications whose retention term ends within 30 days or has ended, with the per-item and bulk decisions extend term, depublish now and archive. Each opens RetentionDecisionDialog, which posts to /api/retention/publications/{id}/decision; the decision is the action id. The report downloads /api/retention/report. A row opens RetentionPublication, the publication's retention fields and decision log.",
	"menu": [
		{
			"id": "RetentionReviewMenu",
			"label": "Retention review",
			"icon": "ClockOutline",
			"route": "RetentionReview",
			"section": "settings",
			"order": 95,
			"permission": "admin"
		}
	],
	"pages": [
		{
			"id": "RetentionReview",
			"route": "/retention",
			"type": "index",
			"title": "Retention review",
			"permission": "admin",
			"config": {
				"register": "@resolve:publication_register",
				"schema": "@resolve:publication_schema",
				"description": "Publications whose retention term ends within 30 days or has ended",
				"quickFilters": [
					{
						"label": "Expiring soon",
						"filter": {
							"retentionExpiresAt": {
								"gt": "@now",
								"lte": "@today+30d"
							}
						}
					},
					{
						"label": "Review needed",
						"filter": {
							"retentionAction": "review",
							"retentionExpiresAt": {
								"lte": "@now"
							}
						}
					},
					{
						"label": "Both",
						"default": true,
						"filter": {
							"retentionExpiresAt": {
								"lte": "@today+30d"
							}
						}
					},
					{
						"label": "Archived",
						"filter": {
							"status": "archived"
						}
					}
				],
				"columns": [
					{
						"key": "title",
						"label": "Publication",
						"sortable": true
					},
					{
						"key": "retentionCategory",
						"label": "Retention category"
					},
					{
						"key": "retentionExpiresAt",
						"label": "Expires on",
						"formatter": "date",
						"sortable": true
					},
					{
						"key": "retentionAction",
						"label": "Rule says"
					},
					{
						"key": "retentionTermMonths",
						"label": "Retention term (months)"
					}
				],
				"sortKey": "retentionExpiresAt",
				"sortOrder": "asc",
				"rowRoute": "RetentionPublication",
				"actions": [
					{
						"id": "extend",
						"label": "Extend term",
						"icon": "CalendarClock",
						"handler": "openRetentionDecision"
					},
					{
						"id": "depublish",
						"label": "Depublish now",
						"icon": "PublishOff",
						"handler": "openRetentionDecision"
					},
					{
						"id": "archive",
						"label": "Archive",
						"icon": "ArchiveOutline",
						"handler": "openRetentionDecision"
					}
				],
				"bulkActions": [
					{
						"id": "extend",
						"label": "Extend term",
						"icon": "CalendarClock",
						"handler": "openRetentionDecision"
					},
					{
						"id": "depublish",
						"label": "Depublish now",
						"icon": "PublishOff",
						"handler": "openRetentionDecision"
					},
					{
						"id": "archive",
						"label": "Archive",
						"icon": "ArchiveOutline",
						"handler": "openRetentionDecision"
					}
				],
				"headerActions": [
					{
						"id": "retention-report",
						"label": "Retention report",
						"icon": "FileChartOutline",
						"handler": "downloadRetentionReport"
					}
				],
				"actionToggles": {
					"showAdd": false,
					"showViewAction": false,
					"showEditAction": false,
					"showCopyAction": false,
					"showDeleteAction": false,
					"showMassImport": false,
					"showMassExport": false,
					"showMassCopy": false,
					"showMassDelete": false,
					"showViewToggle": false,
					"selectable": true
				},
				"footerNote": "Extending a term asks for a note, which stays in the history.",
				"emptyText": "No publication needs a retention decision",
				"documentationUrl": "https://opencatalogi.conduction.nl"
			}
		},
		{
			"id": "RetentionPublication",
			"route": "/retention/:id",
			"type": "detail",
			"title": "Retention review",
			"permission": "admin",
			"_note": "capability-rows-close-gaps task 2.6: where a queue row opens. The publication's identity and its retention fields with the decision log, read-only: a decision is taken from the queue's actions, which ask for a note. History is the audit trail in the sidebar.",
			"config": {
				"register": "@resolve:publication_register",
				"schema": "@resolve:publication_schema",
				"idParam": "@route.id",
				"notFoundRoute": {
					"name": "RetentionReview"
				},
				"notFoundRouteLabel": "Retention review",
				"documentationUrl": "https://opencatalogi.conduction.nl",
				"widgets": [
					{
						"id": "retention-publication",
						"type": "data",
						"title": "Publication",
						"icon": "FileDocument",
						"content": {
							"columns": 2,
							"include": [
								"title",
								"summary",
								"publicationDate",
								"depublicationDate",
								"status"
							],
							"overrides": {
								"title": {
									"editable": false
								},
								"summary": {
									"editable": false
								},
								"publicationDate": {
									"editable": false
								},
								"depublicationDate": {
									"editable": false
								},
								"status": {
									"editable": false
								}
							}
						}
					},
					{
						"id": "retention-fields",
						"type": "data",
						"title": "Retention",
						"icon": "History",
						"content": {
							"columns": 2,
							"include": [
								"retentionCategory",
								"retentionTermMonths",
								"retentionAction",
								"retentionExpiresAt",
								"retentionNote",
								"retentionLastEvaluatedAt",
								"retentionDecisionLog"
							],
							"overrides": {
								"retentionCategory": {
									"editable": false
								},
								"retentionTermMonths": {
									"editable": false
								},
								"retentionAction": {
									"editable": false
								},
								"retentionExpiresAt": {
									"editable": false
								},
								"retentionNote": {
									"editable": false
								},
								"retentionLastEvaluatedAt": {
									"editable": false
								},
								"retentionDecisionLog": {
									"editable": false
								}
							}
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "retention-publication",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 3
					},
					{
						"id": "2",
						"widgetId": "retention-fields",
						"gridX": 0,
						"gridY": 3,
						"gridWidth": 12,
						"gridHeight": 5
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				}
			}
		}
	]
}
