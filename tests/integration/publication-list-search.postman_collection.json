				],
				"url": {
					"raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication?_search={{runId}}summary&_limit=10",
					"host": ["{{baseUrl}}"],
					"path": ["apps", "openregister", "api", "objects", "publication", "publication"],
					"query": [
						{ "key": "_search", "value": "{{runId}}summary" },
						{ "key": "_limit", "value": "10" }
					]
				}
			}
		},
