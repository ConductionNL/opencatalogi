		{
			"name": "Without a search term the full list is back",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('200', () => pm.response.to.have.status(200));",
							"const body = pm.response.json();",
							"const ids = body.results.map((r) => r.id);",
							"pm.test('the unfiltered total includes the whole run', () => pm.expect(body.total).to.be.at.least(3));",
							"pm.test('all three publications are listed', () => {",
							"\tfor (const key of ['idAlpha', 'idBravo', 'idCharlie']) {",
							"\t\tpm.expect(ids).to.include(pm.collectionVariables.get(key));",
							"\t}",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Authorization", "value": "{{userAuth}}" }
				],
				"url": {
					"raw": "{{baseUrl}}/apps/openregister/api/objects/publication/publication?_limit=50&_order=%7B%22%40self.created%22%3A%22desc%22%7D",
					"host": ["{{baseUrl}}"],
					"path": ["apps", "openregister", "api", "objects", "publication", "publication"],
					"query": [
						{ "key": "_limit", "value": "50" },
						{ "key": "_order", "value": "%7B%22%40self.created%22%3A%22desc%22%7D", "description": "{\"@self.created\":\"desc\"}, so the publications just created are on the first page" }
					]
				}
			}
		},
